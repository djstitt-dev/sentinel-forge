#!/usr/bin/env python3
from __future__ import annotations
import argparse
import json
from pathlib import Path
import sys

REPO=Path(__file__).resolve().parent.parent
sys.path.insert(0,str(REPO))

from sentinel_forge.knowledge_library import KnowledgeLibrary

p=argparse.ArgumentParser(description="Sentinel Forge offline knowledge library")
sub=p.add_subparsers(dest="command", required=True)
ing=sub.add_parser("ingest", help="ingest one approved UTF-8 .txt/.md source")
ing.add_argument("path")
sea=sub.add_parser("search", help="search the offline library")
sea.add_argument("query")
sub.add_parser("stats", help="show library statistics")
args=p.parse_args()
lib=KnowledgeLibrary()
if args.command=="ingest":
    print(json.dumps(lib.ingest(Path(args.path).resolve()), indent=2, sort_keys=True))
elif args.command=="search":
    for hit in lib.search(args.query):
        print(f"[{hit.citation}] {hit.source_name} sha256={hit.source_sha256}")
        print(hit.text)
        print()
else:
    print(json.dumps(lib.stats(), indent=2, sort_keys=True))
